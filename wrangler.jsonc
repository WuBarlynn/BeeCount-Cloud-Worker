{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beecount-cloud-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./frontend/apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws", "/healthz", "/ready", "/metrics"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beecount-cloud",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "beecount-attachments"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SYNC_HUB", "class_name": "SyncHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncHub"] }],
  "routes": [{ "pattern": "beecount.example.com", "custom_domain": true }],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "vars": {
    "APP_NAME": "BeeCount Cloud",
    "APP_VERSION": "1.9.0-worker.2",
    "ACCESS_TOKEN_TTL": "1800",
    "REFRESH_TOKEN_TTL_DAYS": "30",
    "ALLOW_REGISTRATION": "false"
  },
  "observability": { "enabled": true }
}
